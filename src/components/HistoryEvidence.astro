---
import type {HistoryPage} from '../presentation/history-page';
interface Props {page: HistoryPage}
const {page}=Astro.props;
const {checked,references}=page;
---
<div id="evidence">
  <p class="evidence-status">{checked.length?`${checked.length} statements checked against source passages. Other content in this view is still awaiting claim-level review.`:'Claim-level review is pending for this focus. The links below are research references.'}</p>
  {checked.map(c=><article class="checked-claim"><strong>{c.statement}</strong>{c.citations.map(source=><><a href={source.url} target="_blank" rel="noopener">{source.title} · {source.creator}</a><span>{source.locator}</span><span>{source.note}</span></>)}<small>AI-assisted source check · not independent expert review</small></article>)}
  <h3>Research references</h3>
  {references.map((url,i)=><a href={url} target="_blank" rel="noopener">{i===0?'Focus reference':`Place association reference ${i}`}</a>)}
</div>
