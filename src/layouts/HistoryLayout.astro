---
import type {HistoryEntity} from '../domain/history';
import PageMetadata from '../components/PageMetadata.astro';
import {description} from '../presentation/metadata';
interface Props {focus: HistoryEntity}
const {focus}=Astro.props;

---
<!doctype html>
<html lang="en">
<head>
  <base href="/" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <PageMetadata title={`${focus.title} · Historica`} description={description(focus.description)} path={`/${focus.type}/${focus.id}`} noindex />
  <link rel="stylesheet" href="focus.css?v=exploration-1" />
  <link rel="stylesheet" href="branding.css?v=1" />
</head>
<body data-static-history={focus.id}>
  <slot />
  <!-- Temporary bridge: the existing controller enhances the prerendered default. -->
  <script is:inline type="module" src="focus-app.js?v=exploration-2"></script>
</body>
</html>
