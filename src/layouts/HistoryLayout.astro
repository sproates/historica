---
import {styleUrl} from '../../scripts/static/assets.mjs';
import type {HistoryEntity} from '../domain/history';
import Appearance from '../components/Appearance.astro';
import PageMetadata from '../components/PageMetadata.astro';
import {description} from '../presentation/metadata';
interface Props {focus: HistoryEntity}
const {focus}=Astro.props;

---
<!doctype html>
<html lang="en">
<head>
  <base href="/" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <PageMetadata title={`${focus.title} · Historica`} description={description(focus.description)} path={`/${focus.type}/${focus.id}`} noindex />
  <link rel="stylesheet" href={styleUrl('focus.css')} />
  <link rel="stylesheet" href={styleUrl('branding.css')} />
  <Appearance />
</head>
<body data-static-history={focus.id}>
  <slot />
  <!-- Typed controls enhance the prerendered default. -->
  <script is:inline type="module" src="focus-app.js"></script>
</body>
</html>
