---
import PageMetadata from '../components/PageMetadata.astro';
interface Props {title: string; description: string; path: string; page: 'home'|'about'}
const {title,description,path,page}=Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <base href="/" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <PageMetadata title={title} description={description} path={path} website={page==='home'} noindex />
  <link rel="stylesheet" href="focus.css" />
  <link rel="stylesheet" href="branding.css" />
  <link rel="stylesheet" href="welcome.css" />
</head>
<body data-static-page={page}>
  <slot />
  {page==='home' && <script is:inline type="module" src="home.js"></script>}
</body>
</html>
