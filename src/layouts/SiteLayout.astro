---
import {styleUrl} from '../../scripts/static/assets.ts';
import Appearance from '../components/Appearance.astro';
import PageMetadata from '../components/PageMetadata.astro';
interface Props {title: string; description: string; path: string; page: 'home'|'about'|'coverage'|'privacy'}
const {title,description,path,page}=Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <base href="/" />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <PageMetadata title={title} description={description} path={path} website={page==='home'} noindex />
  <link rel="stylesheet" href={styleUrl('focus.css')} />
  <link rel="stylesheet" href={styleUrl('branding.css')} />
  <link rel="stylesheet" href={styleUrl(page==='coverage'?'coverage.css':'welcome.css')} />
  <Appearance />
</head>
<body data-static-page={page}>
  <slot />
  {page==='home' && <script is:inline type="module" src="generated/entrypoints/home.js"></script>}
  {page==='coverage' && <script is:inline type="module" src="generated/entrypoints/coverage-app.js"></script>}
</body>
</html>
