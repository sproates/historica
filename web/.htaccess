# Generated by scripts/build-routes.mjs. Scoped to historica.online only.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(?:www\.)?historica\.online$ [NC]
RewriteRule ^ https://historica.online%{REQUEST_URI} [R=301,L,NE]
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^person/(?:alexander|philip|ptolemy|aristotle|darius|olympias|demosthenes|plato|mencius|socrates)/?$ index.html [L]
RewriteRule ^area/(?:egypt|bactria|epirus|china|india|oaxaca|britain-ireland|danebury|castell-henllys|corlea|global-overview)/?$ index.html [L]
RewriteRule ^state/(?:macedonia|persia|qin|chu|maurya)/?$ index.html [L]
RewriteRule ^city/(?:bactra|athens|pataliputra|rome|carthage|monte-alban-city|memphis|thebes-egypt)/?$ index.html [L]
RewriteRule ^period/(?:period|china-warring|italy-settlement|samnite-war|monte-alban|philip-reign|ptolemy-rule|world-400-250|darius-rule|lyceum|qin-reforms|chu-silk|daodejing|ashoka-rule|pyrrhic-war|first-punic|danebury-life|broxmouth|ireland-iron-age|henllys-community|doogarrymore-wheels|predynastic-egypt|badarian-culture|maadi-culture|naqada-one|old-kingdom|djoser-reign|khufu-reign|new-kingdom|uruk-urban|mesopotamian-city-states|indus-urban|shang-context|western-zhou|eastern-zhou|western-han|eastern-han|han-wu-reign|olmec-gulf|la-venta-context|caral-context|kush-overview|northern-jomon|sannai-maruyama|korean-dolmens|dilmun-burials|lapita-settlement|arnhem-rock-art|chavin-context|poverty-point|sammallahdenmaki|teotihuacan-context|villanovan-context|etruscan-context|parthian-context|mithridates-one-reign|jenne-jeno-early|aksum-context|sanchi-early|scythian-black-sea|early-dynastic-egypt|first-intermediate-egypt|middle-kingdom-egypt|second-intermediate-egypt|third-intermediate-egypt|late-period-egypt|macedonian-ptolemaic-egypt|roman-egypt|snefru-reign|khafre-reign|menkaure-reign|amenemhat-one-reign|senwosret-three-reign|hatshepsut-reign|thutmose-three-reign|amenhotep-three-reign|akhenaten-reign|tutankhamun-reign|seti-one-reign|ramesses-two-reign|amarna-religion|deir-el-medina-artisans)/?$ index.html [L]
RewriteRule ^event/(?:stage-macedonia|stage-thebes|stage-asia-minor|stage-issus|stage-tyre|stage-egypt|stage-gaugamela|stage-persepolis|stage-bactria|stage-sogdiana|stage-hydaspes|stage-indus|stage-gedrosia|stage-susa|stage-babylon|ptolemy-egypt|philip-king|chaeronea|ptolemy-king|academy|maurya-foundation|maurya-expansion|kalinga|ashoka-edicts|socrates-trial|corlea-construction)/?$ index.html [L]
