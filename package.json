{
  "name": "historica",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 scripts/preview-server.py",
    "test": "npm run build:client && node --test tests/*.test.mjs",
    "start:lan": "python3 scripts/preview-server.py --bind 0.0.0.0",
    "validate:research": "node scripts/validate-evidence.mjs",
    "audit:prototype": "node scripts/audit-prototype.mjs",
    "build:evidence": "node scripts/build-evidence.mjs",
    "build:coverage": "node scripts/build-coverage.mjs",
    "build:site": "npm run build:client && npm run build:evidence && npm run build:coverage && node scripts/build-routes.mjs && node scripts/build-metadata.mjs && npm test && node scripts/build-site.mjs",
    "package:site": "npm run build:site && python3 scripts/package-site.py",
    "preview:sync": "npm run build:client && python3 scripts/sync-preview.py",
    "preview:install": "python3 scripts/install-preview-service.py",
    "build:pages": "npm run build:client && node scripts/build-pages.mjs",
    "build:client": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
