{
  "name": "historica",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 scripts/preview-server.py",
    "test": "npm run build:web && node scripts/validate-history.ts && node --test tests/*.test.ts",
    "start:lan": "python3 scripts/preview-server.py --bind 0.0.0.0",
    "validate:research": "node scripts/validate-evidence.ts",
    "audit:prototype": "node scripts/audit-prototype.ts",
    "build:evidence": "npm run build:client && node scripts/build-evidence.ts && node scripts/build-map-regions.ts",
    "build:coverage": "node scripts/build-coverage.ts",
    "build:site": "npm test && node scripts/build-site.ts",
    "package:site": "npm run build:site && python3 scripts/package-site.py",
    "preview:sync": "npm run build:web && python3 scripts/sync-preview.py",
    "preview:install": "python3 scripts/install-preview-service.py",
    "package:static": "npm run build:pages",
    "build:pages": "npm run build:web && node scripts/build-pages.ts --static-source release/static-incremental && node scripts/verify-pages.ts",
    "build:client": "node scripts/build-client.ts",
    "typecheck": "npm run build:client && tsc -p tsconfig.tools.json",
    "validate:history": "npm run build:client && node scripts/validate-history.ts",
    "build:content": "npm run build:evidence && tsc -p tsconfig.tools.json && node scripts/build-coverage.ts && node scripts/build-routes.ts && node scripts/build-metadata.ts",
    "build:static": "npm run build:evidence && npm run check:static && astro build",
    "preview:static": "npm run preview:sync",
    "test:static": "npm run build:static && node --test tests/static/*.test.ts",
    "check:static": "astro check --tsconfig tsconfig.astro.json",
    "build:static:incremental": "npm run build:evidence && node scripts/build-static-incremental.ts",
    "preview:static:incremental": "npm run preview:sync",
    "prestart": "npm run build:web",
    "prestart:lan": "npm run build:web",
    "prepreview:install": "npm run build:web",
    "prebuild:coverage": "npm run build:client",
    "build:web": "npm run build:content && node scripts/verify-static-incremental.ts && node scripts/export-static-web.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/leaflet": "1.9.21",
    "@types/node": "26.6.6",
    "astro": "7.4.13",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  }
}
